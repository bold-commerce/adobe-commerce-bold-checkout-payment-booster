<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Customer:etc/sections.xsd">
    <action name="checkout/cart/delete">
        <section name="bold-checkout-data"/>
    </action>
    <action name="checkout/cart/add">
        <section name="bold-checkout-data"/>
    </action>
    <action name="checkout/onepage/success">
        <section name="bold-checkout-data"/>
    </action>
    <action name="bold_booster/digitalwallets_quote/create">
        <section name="cart"/>
        <section name="bold-checkout-data"/>
    </action>
    <action name="bold_booster/digitalwallets_checkout/getconfig">
        <section name="bold-checkout-data"/>
    </action>
    <action name="rest/*/V1/carts/*/payment-information">
        <section name="bold-checkout-data"/>
    </action>
    <action name="rest/*/V1/guest-carts/*/payment-information">
        <section name="bold-checkout-data"/>
    </action>
</config>
